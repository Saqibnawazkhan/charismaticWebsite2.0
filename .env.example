# Copy this file to .env.local and fill in the values to have website forms emailed to you.
# Without RESEND_API_KEY, form submissions are only printed in the server console.

# API key from https://resend.com (free tier is enough for a care website's enquiries)
RESEND_API_KEY=

# Where enquiries, brochure requests and job applications are sent (comma-separate several addresses)
ENQUIRY_TO_EMAIL=contact@charismaticcare.net

# Sender shown on the emails. Must be on a domain you have verified in Resend, e.g. website@charismaticcare.net
ENQUIRY_FROM_EMAIL=Charismatic Care Website <website@charismaticcare.net>
